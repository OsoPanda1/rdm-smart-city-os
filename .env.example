# ─────────────────────────────────────────────────────────────
# RDM Digital · Nodo Cero — Variables de entorno (Vercel / local)
# Copia este archivo como `.env` en local y replica las mismas
# claves en Vercel → Project Settings → Environment Variables
# (Production, Preview y Development).
# ─────────────────────────────────────────────────────────────

# ── Frontend (obligatorias, se inyectan en el bundle con Vite) ──
# URL del proyecto backend (Supabase / Postgres gestionado)
VITE_SUPABASE_URL="https://hgziffdntpjutuqaddbe.supabase.co"
# Clave publicable (anon). Es pública por diseño: la seguridad la da RLS.
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....<anon-key>"
# Identificador del proyecto backend
VITE_SUPABASE_PROJECT_ID="hgziffdntpjutuqaddbe"

# ── Frontend (opcionales) ──
# Dominio canónico usado para canonical/OG/sitemap
VITE_SITE_URL="https://admin.visitarealdelmonte.online"
# URL de la API territorial (nodo-cero). En local usa /api con proxy Vite;
# en producción (Vercel) apunta al subdominio API de nodo-cero.
VITE_API_URL="https://api.visitarealdelmonte.online"
# Modo de mantenimiento: "true" muestra la pantalla de mantenimiento en todo el sitio.
# Override temporal sin redeploy: ?maintenance=on | ?maintenance=off | ?maintenance=reset
VITE_MAINTENANCE_MODE="false"
VITE_MAINTENANCE_MESSAGE="Estamos desplegando una nueva versión soberana del sistema. Volvemos en unos minutos."

# ── Backend / Edge Functions (NUNCA en el frontend ni en Vercel) ──
# Se configuran como secretos del backend, no como variables de Vercel:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY   (solo servidor)
#   SUPABASE_DB_URL             (cadena Postgres, solo servidor)
#   GITHUB_TOKEN                (ingesta de la federación)
#   STRIPE_SECRET_KEY           (pagos/membresías)
#   LOVABLE_API_KEY             (gateway de IA)

# ── Storage / buckets ──
# Bucket privado de audio de la playlist soberana: `tracks-audio`
# Las URLs se firman en tiempo de ejecución con la sesión del usuario;
# no requiere variable adicional.
